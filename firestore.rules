rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function onlyChanges(keys) {
      return incoming().diff(existing()).affectedKeys().hasOnly(keys);
    }

    // Profile pictures are small JPEG data URLs (~256px) or https links (e.g. Google photo).
    function smallImageOrAbsent(field) {
      return !(field in incoming())
        || (incoming()[field] is string && incoming()[field].size() <= 150000);
    }

    // Social links and proof of work are short lists on the profile.
    function profileListsOk() {
      return (!('socialLinks' in incoming()) || (incoming().socialLinks is list && incoming().socialLinks.size() <= 8))
        && (!('proofItems' in incoming()) || (incoming().proofItems is list && incoming().proofItems.size() <= 8));
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isProvider() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).data.accountType == 'provider';
    }

    // Default deny everything not matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // User profiles — public profiles; owners edit their own.
    // `verified` can only be set by an admin (Firebase console / Admin SDK).
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;

      allow create: if isSignedIn() && uid() == userId
        && incoming().accountType in ['artist', 'provider']
        && !('verified' in incoming())
        && !('payoutsReady' in incoming())
        && !('email' in incoming())
        && smallImageOrAbsent('avatarUrl')
        && profileListsOk()
        // Age gate: only adults can create a profile.
        && incoming().ageConfirmed == true;

      allow update: if isSignedIn() && uid() == userId
        && incoming().accountType in ['artist', 'provider']
        && incoming().get('verified', false) == existing().get('verified', false)
        && incoming().get('payoutsReady', false) == existing().get('payoutsReady', false)
        && !('email' in incoming())
        && smallImageOrAbsent('avatarUrl')
        && profileListsOk()
        // Once confirmed, the age confirmation can't be removed.
        && (existing().get('ageConfirmed', false) != true || incoming().ageConfirmed == true);

      allow delete: if isSignedIn() && uid() == userId;
    }

    // ---------------------------------------------------------------
    // Quests — anyone can browse; only Studio (provider) accounts post.
    // ---------------------------------------------------------------
    match /quests/{questId} {
      allow read: if true;

      allow create: if isSignedIn() && isProvider()
        && incoming().clientUid == uid()
        && incoming().status == 'open'
        && incoming().title is string && incoming().title.size() >= 3 && incoming().title.size() <= 140
        && incoming().description is string && incoming().description.size() <= 5000
        && incoming().budget is number && incoming().budget > 0 && incoming().budget <= 1000000
        && incoming().milestones is list && incoming().milestones.size() >= 1 && incoming().milestones.size() <= 10
        && smallImageOrAbsent('clientAvatar');

      allow update: if isSignedIn() && existing().clientUid == uid()
        && incoming().clientUid == existing().clientUid
        && incoming().status in ['open', 'active', 'completed'];

      allow delete: if isSignedIn() && existing().clientUid == uid();
    }

    // ---------------------------------------------------------------
    // Applications — id is "{questId}_{applicantUid}" (one per creative per quest).
    // Visible only to the applicant and the studio that owns the quest.
    // ---------------------------------------------------------------
    match /applications/{applicationId} {
      allow read: if isSignedIn()
        && (existing().applicantUid == uid() || existing().clientUid == uid());

      allow create: if isSignedIn()
        && incoming().applicantUid == uid()
        && applicationId == incoming().questId + '_' + uid()
        && incoming().status == 'pending'
        && incoming().bidAmount is number && incoming().bidAmount > 0
        && incoming().proposalText is string && incoming().proposalText.size() >= 20 && incoming().proposalText.size() <= 5000
        && exists(/databases/$(database)/documents/quests/$(incoming().questId))
        && get(/databases/$(database)/documents/quests/$(incoming().questId)).data.status == 'open'
        && incoming().clientUid == get(/databases/$(database)/documents/quests/$(incoming().questId)).data.clientUid
        && incoming().clientUid != uid()
        && smallImageOrAbsent('applicantAvatar');

      // The studio can accept or decline; nothing else about the application changes.
      allow update: if isSignedIn() && existing().clientUid == uid()
        && onlyChanges(['status', 'updatedAt'])
        && incoming().status in ['pending', 'accepted', 'declined'];

      // The creative can withdraw while it's still pending.
      allow delete: if isSignedIn() && existing().applicantUid == uid()
        && existing().status == 'pending';
    }

    // ---------------------------------------------------------------
    // Contracts — id is "{questId}_{creativeUid}" (same as the application).
    // Only the gig provider (client) and the hired creative can see them.
    // ---------------------------------------------------------------
    function contractPath(contractId) {
      return /databases/$(database)/documents/contracts/$(contractId);
    }

    function isParticipantOf(contractId) {
      return isSignedIn() && uid() in get(contractPath(contractId)).data.participants;
    }

    function statusMoves(from, to) {
      return existing().status in from && incoming().status == to;
    }

    match /contracts/{contractId} {
      allow read: if isSignedIn() && uid() in existing().participants;

      // Created by the gig provider in the same write that accepts the application.
      allow create: if isSignedIn()
        && incoming().clientUid == uid()
        && contractId == incoming().questId + '_' + incoming().creativeUid
        && incoming().participants == [uid(), incoming().creativeUid]
        && incoming().status == 'setup'
        && incoming().totalAmount is number && incoming().totalAmount > 0
        && get(/databases/$(database)/documents/quests/$(incoming().questId)).data.clientUid == uid()
        && getAfter(/databases/$(database)/documents/applications/$(contractId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/applications/$(contractId)).data.clientUid == uid()
        && getAfter(/databases/$(database)/documents/applications/$(contractId)).data.applicantUid == incoming().creativeUid
        && smallImageOrAbsent('clientAvatar')
        && smallImageOrAbsent('creativeAvatar');

      allow update: if isSignedIn() && uid() in existing().participants
        && incoming().participants == existing().participants
        && incoming().clientUid == existing().clientUid
        && incoming().creativeUid == existing().creativeUid
        && (
          // Either party: chat preview only
          (incoming().status == existing().status
            && onlyChanges(['lastMessageAt', 'lastMessagePreview', 'lastMessageBy']))

          // Gig provider
          || (uid() == existing().clientUid && (
                (existing().status == 'setup' && incoming().status == 'setup'
                  && onlyChanges(['totalAmount', 'updatedAt'])
                  && incoming().totalAmount is number && incoming().totalAmount > 0)
             || (statusMoves(['setup'], 'proposed') && onlyChanges(['status', 'updatedAt', 'changeRequest']))
             || (statusMoves(['setup', 'proposed', 'awaiting_payment'], 'cancelled') && onlyChanges(['status', 'updatedAt'])
                  && existing().get('paymentStatus', '') != 'processing')
             || (statusMoves(['active'], 'completed') && onlyChanges(['status', 'updatedAt']))
          ))

          // Creative
          || (uid() == existing().creativeUid && (
                (statusMoves(['proposed'], 'awaiting_payment') && onlyChanges(['status', 'updatedAt']))
             || (statusMoves(['proposed'], 'setup') && onlyChanges(['status', 'updatedAt', 'changeRequest'])
                  && incoming().changeRequest is string && incoming().changeRequest.size() <= 2000)
             || (statusMoves(['setup', 'proposed', 'awaiting_payment'], 'cancelled') && onlyChanges(['status', 'updatedAt'])
                  && existing().get('paymentStatus', '') != 'processing')
          ))
        );

      allow delete: if false;

      // --- Milestones -------------------------------------------------
      match /milestones/{milestoneId} {
        function contractAfter() {
          return getAfter(contractPath(contractId)).data;
        }
        function contractNow() {
          return get(contractPath(contractId)).data;
        }
        function validPlanItem() {
          return incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 200
            && incoming().amount is number && incoming().amount > 0
            && incoming().order is int && incoming().order >= 0 && incoming().order < 20;
        }

        allow read: if isSignedIn() && uid() in contractNow().participants;

        // Gig provider shapes the plan while the contract is in setup.
        allow create: if isSignedIn()
          && contractAfter().clientUid == uid()
          && contractAfter().status == 'setup'
          && incoming().status == 'pending'
          && validPlanItem();

        allow delete: if isSignedIn()
          && contractNow().clientUid == uid()
          && contractNow().status == 'setup';

        allow update: if isSignedIn() && (
          // Plan edits during setup (gig provider)
          (contractNow().clientUid == uid() && contractNow().status == 'setup'
            && onlyChanges(['title', 'amount', 'order'])
            && validPlanItem())

          // Creative submits work for review
          || (contractNow().creativeUid == uid() && contractNow().status == 'active'
            && existing().status in ['pending', 'changes_requested']
            && incoming().status == 'submitted'
            && onlyChanges(['status', 'submissionNote', 'submittedAt'])
            && incoming().submissionNote is string && incoming().submissionNote.size() <= 2000)

          // Gig provider asks for changes. Approving releases money, so it
          // only happens in the approveMilestone server function.
          || (contractNow().clientUid == uid() && contractNow().status == 'active'
            && existing().status == 'submitted'
            && incoming().status == 'changes_requested'
            && onlyChanges(['status', 'feedback', 'reviewedAt', 'revisionCount'])
            && incoming().get('revisionCount', 0) == existing().get('revisionCount', 0) + 1
            && incoming().feedback is string && incoming().feedback.size() <= 2000)
        );
      }

      // --- Messages (append-only) ---------------------------------------
      match /messages/{messageId} {
        allow read: if isParticipantOf(contractId);

        allow create: if isParticipantOf(contractId)
          && incoming().senderUid == uid()
          && incoming().type in ['text', 'file', 'system']
          && incoming().text is string && incoming().text.size() <= 4000
          && incoming().createdAt == request.time
          && (incoming().type != 'file'
              || (incoming().file.path is string
                  && incoming().file.path.matches('contracts/' + contractId + '/' + uid() + '/.*')));

        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // Reviews — written only by the submitReview server function.
    // Hidden until both sides have reviewed (or the window closes);
    // the author can always see their own.
    // ---------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if existing().released == true
        || (isSignedIn() && existing().reviewerUid == uid());
      allow write: if false;
    }

    // Track record computed by the server from contracts and reviews.
    match /publicStats/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Bookmarks — private to each user.
    // ---------------------------------------------------------------
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && existing().userId == uid();
      allow create: if isSignedIn() && incoming().userId == uid()
        && bookmarkId == uid() + '_' + incoming().questId;
      allow delete: if isSignedIn() && existing().userId == uid();
    }
  }
}
