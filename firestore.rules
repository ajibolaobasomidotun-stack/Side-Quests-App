rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function onlyChanges(keys) {
      return incoming().diff(existing()).affectedKeys().hasOnly(keys);
    }

    // Profile pictures are small JPEG data URLs (~256px) or https links (e.g. Google photo).
    function smallImageOrAbsent(field) {
      return !(field in incoming())
        || (incoming()[field] is string && incoming()[field].size() <= 150000);
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isProvider() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc(uid()).data.accountType == 'provider';
    }

    // Default deny everything not matched below
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // User profiles — public profiles; owners edit their own.
    // `verified` can only be set by an admin (Firebase console / Admin SDK).
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;

      allow create: if isSignedIn() && uid() == userId
        && incoming().accountType in ['artist', 'provider']
        && !('verified' in incoming())
        && !('email' in incoming())
        && smallImageOrAbsent('avatarUrl');

      allow update: if isSignedIn() && uid() == userId
        && incoming().accountType in ['artist', 'provider']
        && incoming().get('verified', false) == existing().get('verified', false)
        && !('email' in incoming())
        && smallImageOrAbsent('avatarUrl');

      allow delete: if isSignedIn() && uid() == userId;
    }

    // ---------------------------------------------------------------
    // Quests — anyone can browse; only Studio (provider) accounts post.
    // ---------------------------------------------------------------
    match /quests/{questId} {
      allow read: if true;

      allow create: if isSignedIn() && isProvider()
        && incoming().clientUid == uid()
        && incoming().status == 'open'
        && incoming().title is string && incoming().title.size() >= 3 && incoming().title.size() <= 140
        && incoming().description is string && incoming().description.size() <= 5000
        && incoming().budget is number && incoming().budget > 0 && incoming().budget <= 1000000
        && incoming().milestones is list && incoming().milestones.size() >= 1 && incoming().milestones.size() <= 10
        && smallImageOrAbsent('clientAvatar');

      allow update: if isSignedIn() && existing().clientUid == uid()
        && incoming().clientUid == existing().clientUid
        && incoming().status in ['open', 'active', 'completed'];

      allow delete: if isSignedIn() && existing().clientUid == uid();
    }

    // ---------------------------------------------------------------
    // Applications — id is "{questId}_{applicantUid}" (one per creative per quest).
    // Visible only to the applicant and the studio that owns the quest.
    // ---------------------------------------------------------------
    match /applications/{applicationId} {
      allow read: if isSignedIn()
        && (existing().applicantUid == uid() || existing().clientUid == uid());

      allow create: if isSignedIn()
        && incoming().applicantUid == uid()
        && applicationId == incoming().questId + '_' + uid()
        && incoming().status == 'pending'
        && incoming().bidAmount is number && incoming().bidAmount > 0
        && incoming().proposalText is string && incoming().proposalText.size() >= 20 && incoming().proposalText.size() <= 5000
        && exists(/databases/$(database)/documents/quests/$(incoming().questId))
        && get(/databases/$(database)/documents/quests/$(incoming().questId)).data.status == 'open'
        && incoming().clientUid == get(/databases/$(database)/documents/quests/$(incoming().questId)).data.clientUid
        && incoming().clientUid != uid()
        && smallImageOrAbsent('applicantAvatar');

      // The studio can accept or decline; nothing else about the application changes.
      allow update: if isSignedIn() && existing().clientUid == uid()
        && onlyChanges(['status', 'updatedAt'])
        && incoming().status in ['pending', 'accepted', 'declined'];

      // The creative can withdraw while it's still pending.
      allow delete: if isSignedIn() && existing().applicantUid == uid()
        && existing().status == 'pending';
    }

    // ---------------------------------------------------------------
    // Bookmarks — private to each user.
    // ---------------------------------------------------------------
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && existing().userId == uid();
      allow create: if isSignedIn() && incoming().userId == uid()
        && bookmarkId == uid() + '_' + incoming().questId;
      allow delete: if isSignedIn() && existing().userId == uid();
    }
  }
}
