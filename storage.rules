rules_version = '2';

// Files delivered inside a contract. Only the two people on the contract can
// read them; each person can only upload into their own folder.
service firebase.storage {
  match /b/{bucket}/o {
    match /contracts/{contractId}/{uploaderUid}/{fileName} {
      function isParticipant() {
        return request.auth != null
          && request.auth.uid in firestore.get(/databases/(default)/documents/contracts/$(contractId)).data.participants;
      }

      allow read: if isParticipant();

      allow create: if isParticipant()
        && request.auth.uid == uploaderUid
        && request.resource.size < 1024 * 1024 * 1024;

      allow update, delete: if false;
    }

    // Proof of work on public profiles: photos (already compressed in the
    // browser) and short videos. Anyone can view; only the owner uploads or deletes.
    match /users/{userId}/proof/{fileName} {
      allow read: if true;

      allow create: if request.auth != null && request.auth.uid == userId
        && fileName.matches('[A-Za-z0-9]+[.](jpg|mp4|mov|webm)')
        && (
          (request.resource.contentType == 'image/jpeg' && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType in ['video/mp4', 'video/quicktime', 'video/webm']
              && request.resource.size < 100 * 1024 * 1024)
        );

      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
